# Never commit .env or the persistent data directory.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Conservative CNY / 1M tokens; recheck pricing and actual bills.
DEEPSEEK_INPUT_CNY_PER_M=3
DEEPSEEK_OUTPUT_CNY_PER_M=12
DEEPSEEK_CACHE_CNY_PER_M=0.2

ASSISTANT_DATA_DIR=.prism-assistant
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8787
ASSISTANT_BUDGET_CNY=50
# Replace with your actual fixed monthly server cost before serve.
ASSISTANT_INFRASTRUCTURE_CNY=20
# Two different random tokens, at least 24 characters each.
ASSISTANT_OWNER_TOKEN=
ASSISTANT_WORKER_TOKEN=

FEISHU_INTELLIGENCE_APP_ID=
FEISHU_INTELLIGENCE_APP_SECRET=
FEISHU_INTELLIGENCE_CHAT_ID=
FEISHU_QA_APP_ID=
FEISHU_QA_APP_SECRET=
FEISHU_QA_CHAT_ID=
FEISHU_ALLOWED_OPEN_IDS=

NOTION_TOKEN=
# Gmail OAuth: gmail.readonly scope, offline refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=from:arxiv.org newer_than:30d
