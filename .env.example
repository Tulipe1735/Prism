# Never commit .env or the persistent data directory.
# Provisional names; the agent kernel is not implemented yet.

# Model: any OpenAI-compatible endpoint; DeepSeek by default.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Browser: reachable Chrome DevTools Protocol endpoint.
PRISM_BROWSER_URL=http://127.0.0.1:9222

# Data directory; defaults to ~/.prism in WSL.
PRISM_DATA_DIR=
