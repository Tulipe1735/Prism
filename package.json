{
  "name": "@tulipe1735/prism",
  "version": "0.1.5",
  "description": "Browser-use CLI for external agents with observation-bound targets and execution receipts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tulipe1735/Prism.git"
  },
  "type": "module",
  "bin": {
    "prism": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup src/interfaces/cli.ts src/interfaces/daemon.ts --format esm --clean --sourcemap --no-splitting && node -e \"require('node:fs').copyFileSync('src/browser/snapshot.js','dist/snapshot.js')\"",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/interfaces/cli.ts",
    "eval": "node --experimental-strip-types --disable-warning=ExperimentalWarning evals/runners/cli.ts",
    "eval:report": "node --experimental-strip-types --disable-warning=ExperimentalWarning evals/runners/report-cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:cohort": "node --experimental-strip-types --disable-warning=ExperimentalWarning evals/runners/cohort.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "chrome-remote-interface": "0.34.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.0.1",
    "@types/chrome-remote-interface": "0.34.0",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@9.15.9"
}
