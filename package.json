{
  "name": "@tulipe1735/prism",
  "version": "0.3.4",
  "description": "Extensible personal agent workbench for Windows and WSL, powered by Cordis. Creator Mode builds and hot-loads plugins from natural-language requests; browser automation is also available as a standalone CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tulipe1735/Prism.git"
  },
  "type": "module",
  "bin": {
    "prism": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "commands",
    "patches",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup --config tsup.config.ts --sourcemap && pnpm build:ui:css && node -e \"const fs=require('node:fs');for(const file of ['index.html','startup.html'])fs.copyFileSync('src/workbench/ui/'+file,'dist/workbench-ui/'+file);fs.cpSync('src/workbench/ui/assets','dist/workbench-ui/assets',{recursive:true});fs.copyFileSync('node_modules/@excalidraw/excalidraw/dist/prod/index.css','dist/workbench-ui/excalidraw.css');fs.cpSync('node_modules/@excalidraw/excalidraw/dist/prod/fonts','dist/workbench-ui/excalidraw/fonts',{recursive:true});fs.copyFileSync('src/browser/snapshot.js','dist/snapshot.js')\"",
    "build:ui:css": "tailwindcss -i src/workbench/ui/app.css -o dist/workbench-ui/app.css --minify",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/interfaces/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test",
    "start": "node dist/cli.js",
    "test": "vitest run --exclude '.scratch/**'",
    "typecheck": "tsc --noEmit && tsc -p src/workbench/ui/tsconfig.json --noEmit",
    "workbench": "node dist/workbench-ui/server.js",
    "workbench:electron": "electron dist/workbench/electron/main.cjs",
    "package:win": "pnpm build && node --use-env-proxy --experimental-strip-types --disable-warning=ExperimentalWarning scripts/package-windows.ts"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "dependencies": {
    "@clerk/electron": "0.1.1",
    "@clerk/localizations": "4.23.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chrome-remote-interface": "0.34.0",
    "cordis": "4.0.0-rc.11",
    "electron-store": "8.2.0",
    "electron-updater": "6.8.9",
    "html-to-text": "^10.0.1",
    "lucide-react": "^1.59.0",
    "node-pty": "1.1.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/chrome-remote-interface": "0.34.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@9.15.9",
  "main": "dist/workbench/electron/main.cjs",
  "productName": "Prism",
  "pnpm": {
    "patchedDependencies": {
      "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
    }
  }
}
