{
  "name": "@prism/action-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --external playwright-core",
    "lint": "eslint .",
    "test": "node ../../scripts/run-vitest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prism/contracts": "workspace:*",
    "playwright-core": "1.61.1"
  },
  "devDependencies": {
    "@prism/tooling-config": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
